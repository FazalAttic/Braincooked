{
  "name": "brainroad",
  "version": "1.0.0",
  "description": "BrainPal-inspired Chrome extension tracking reels and shorts on Instagram and YouTube desktop web.",
  "type": "module",
  "scripts": {
    "build:icons": "node scripts/generate-icons.mjs",
    "build": "npm run build:icons && node scripts/build.mjs",
    "dev": "npm run build:icons && node scripts/build.mjs --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node tests/e2e/test_runner.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "torph": "^0.1.3"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.307",
    "@types/node": "^22.10.1",
    "jsdom": "^26.0.0",
    "typescript": "^5.7.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.5"
  }
}
