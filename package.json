{
  "name": "brainroad-monorepo",
  "version": "1.0.0",
  "description": "Mindfulness tracker counting reels and shorts watched on Instagram and YouTube desktop web with ElysiaJS backend and Next.js dashboard.",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --cwd apps/extension dev",
    "build": "bun run --cwd apps/extension build",
    "build:ext": "bun run --cwd apps/extension build",
    "dev:ext": "bun run --cwd apps/extension dev",
    "test": "bun run --cwd apps/extension test",
    "test:watch": "bun run --cwd apps/extension test:watch",
    "test:e2e": "bun run --cwd apps/extension test:e2e",
    "lint": "bun run --cwd apps/extension lint",
    "dev:backend": "bun run --cwd apps/backend dev",
    "build:backend": "bun run --cwd apps/backend build",
    "dev:web": "bun run --cwd apps/web dev",
    "build:web": "bun run --cwd apps/web build",
    "build:all": "bun run build:ext && bun run build:backend && bun run build:web"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  }
}
