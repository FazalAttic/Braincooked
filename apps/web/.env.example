# Brainroad Full-Stack Configuration
NODE_ENV=development

# Database connection
DATABASE_URL=postgresql://brainroad_user:brainroad_password@localhost:5432/brainroad?sslmode=disable

# Redis cache
REDIS_URL=redis://localhost:6379

# Web URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional API Token for extension development pairing
DEFAULT_DEV_TOKEN=br_dev_token_secret_12345

